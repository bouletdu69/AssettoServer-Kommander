AC_SERVER_INI_PATH=runtime/data/cfg/server_cfg.ini
AC_SERVER_YAML_PATH=runtime/data/cfg/extra_cfg.yml
# Chemin vers le dossier "content" du serveur (voitures, circuits, etc.)
# Si vous utilisez Docker, montez le volume (ex: -v /votre/chemin:/acsm-content)
# et indiquez le chemin interne au conteneur ci-dessous :
AC_CONTENT_PATH=/acsm-content
PORT=8080
